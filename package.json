{
  "name": "gamified-habit-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "A neon RPG-inspired daily habit tracker with a global leaderboard.",
  "main": "desktop.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "desktop": "electron .",
    "dist:win": "electron-builder --win portable"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.okyanus11.habitquest",
    "productName": "Habit Quest",
    "files": [
      "server.js",
      "desktop.js",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    }
  }
}